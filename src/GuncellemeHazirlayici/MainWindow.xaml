<Window x:Class="GuncellemeHazirlayici.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Güncelleme Hazırlayıcı"
        Width="820"
        Height="620"
        MinWidth="500"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBorder"
                Grid.Row="0"
                Background="#172033"
                Padding="32,25">
            <StackPanel>
                <TextBlock Text="Güncelleme Hazırlayıcı"
                           Foreground="White"
                           FontSize="25"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,0"
                           Text="Değiştirilen dosyaları tek bir güncelleme paketinde toplayın."
                           Foreground="#C8D1E0"
                           FontSize="14"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
        <Border x:Name="FormCard"
                Margin="28"
                Padding="26"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E4E7EC"
                BorderThickness="1"
                VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Kaynak klasör"
                           Foreground="{StaticResource TextBrush}"
                           FontWeight="SemiBold"
                           FontSize="14" />
                <Grid Grid.Row="1" Margin="0,7,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SourceFolderTextBox"
                             IsReadOnly="True"
                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <Button x:Name="SourceBrowseButton"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Content="Klasör seç"
                            Click="SourceBrowseButton_Click" />
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="Hedef klasör"
                           Foreground="{StaticResource TextBrush}"
                           FontWeight="SemiBold"
                           FontSize="14" />
                <Grid Grid.Row="3" Margin="0,7,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TargetFolderTextBox"
                             IsReadOnly="True"
                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <Button x:Name="TargetBrowseButton"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Content="Klasör seç"
                            Click="TargetBrowseButton_Click" />
                </Grid>

                <Grid x:Name="DetailsGrid" Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="DetailsGapRow" Height="0" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="DateColumn" Width="230" />
                        <ColumnDefinition x:Name="DetailsSpacerColumn" Width="18" />
                        <ColumnDefinition x:Name="StatusColumn" Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="DateSection" Grid.Column="0">
                        <CheckBox x:Name="InstallationArchiveCheckBox"
                                  Content="Kurulum zipi"
                                  Margin="0,0,0,12"
                                  FontSize="14"
                                  Checked="InstallationArchiveCheckBox_Changed"
                                  Unchecked="InstallationArchiveCheckBox_Changed" />
                        <TextBlock Text="Başlangıç tarihi"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="14" />
                        <DatePicker x:Name="SelectedDatePicker"
                                    Margin="0,7,0,0"
                                    Padding="7"
                                    FontSize="14"
                                    SelectedDateFormat="Long"
                                    SelectedDateChanged="SelectedDatePicker_SelectedDateChanged" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="Seçilen gün 00:00 dahil edilir."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" />
                    </StackPanel>

                    <Border x:Name="StatusBorder"
                            Grid.Column="2"
                            Padding="14,11"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="7"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock x:Name="StatusTitleTextBlock"
                                       Text="Durum"
                                       Foreground="#1E40AF"
                                       FontWeight="SemiBold"
                                       FontSize="13" />
                            <TextBlock x:Name="StatusTextBlock"
                                       Margin="0,3,0,0"
                                       Text="Kaynak ve hedef klasörleri seçin."
                                       Foreground="#1E3A8A"
                                       TextWrapping="Wrap"
                                       FontSize="13" />
                            <ProgressBar x:Name="OperationProgressBar"
                                         Margin="0,9,0,0"
                                         Height="4"
                                         IsIndeterminate="True"
                                         Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="FooterGrid" Grid.Row="5" Margin="0,24,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="FooterGapRow" Height="0" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterDescriptionTextBlock"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="Alt klasör yapısı korunur; temp, pdf, excell, indir, .config ve deepzoom.aspx atlanır." />
                    <Button x:Name="CreateArchiveButton"
                            Grid.Column="1"
                            MinWidth="170"
                            Content="ZIP Hazırla"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Click="CreateArchiveButton_Click" />
                </Grid>
            </Grid>
        </Border>
        </ScrollViewer>
    </Grid>
</Window>
